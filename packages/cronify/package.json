{
  "name": "cronify",
  "version": "0.1.0",
  "description": "Scheduling for serverless Next.js apps: defineJob(), route generation, and a CLI to sync jobs with a self-hosted cronify scheduler.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.17.0"
  },
  "bin": {
    "cronify": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./lock": {
      "types": "./dist/lock.d.ts",
      "import": "./dist/lock.js",
      "require": "./dist/lock.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "typescript": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.2.0",
    "vitest": "^2.0.0"
  }
}
