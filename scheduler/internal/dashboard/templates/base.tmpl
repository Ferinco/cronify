{{define "base.tmpl"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{if .Title}}{{.Title}} · {{end}}cronify</title>
<style>
  :root {
    color-scheme: light dark;
    --bg: #ffffff;
    --fg: #1a1d21;
    --muted: #6b7280;
    --border: #e5e7eb;
    --card: #f9fafb;
    --accent: #2563eb;
    --danger: #b91c1c;
    --danger-bg: #fef2f2;
    --ok: #15803d;
    --ok-bg: #f0fdf4;
    --warn: #92400e;
    --warn-bg: #fffbeb;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f1115;
      --fg: #e5e7eb;
      --muted: #9ca3af;
      --border: #262a31;
      --card: #171a1f;
      --accent: #60a5fa;
      --danger: #f87171;
      --danger-bg: #2a1414;
      --ok: #4ade80;
      --ok-bg: #12241a;
      --warn: #fbbf24;
      --warn-bg: #2a2110;
    }
  }
  * { box-sizing: border-box; }
  body {
    font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1.25rem 3rem;
    color: var(--fg);
    background: var(--bg);
  }
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.5rem;
  }
  header .brand { font-weight: 700; font-size: 1.1rem; color: var(--fg); text-decoration: none; }
  h1 { font-size: 1.3rem; margin: 0 0 1rem; }
  h2 { font-size: 1rem; margin: 1.75rem 0 0.75rem; color: var(--muted); text-transform: uppercase; letter-spacing: .03em; }
  a { color: var(--accent); }
  table { width: 100%; border-collapse: collapse; margin-bottom: 1rem; }
  th, td { text-align: left; padding: 0.55rem 0.6rem; border-bottom: 1px solid var(--border); vertical-align: top; }
  th { color: var(--muted); font-weight: 600; font-size: 0.8rem; text-transform: uppercase; letter-spacing: .02em; }
  tr:last-child td { border-bottom: none; }
  .muted { color: var(--muted); }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.9em; }
  .badge { display: inline-block; padding: 0.15rem 0.5rem; border-radius: 999px; font-size: 0.78rem; font-weight: 600; }
  .badge-success { color: var(--ok); background: var(--ok-bg); }
  .badge-failed { color: var(--danger); background: var(--danger-bg); }
  .badge-in_progress { color: var(--warn); background: var(--warn-bg); }
  .badge-paused { color: var(--muted); background: var(--card); }
  .badge-none { color: var(--muted); background: var(--card); }
  .actions { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  form.inline { display: inline; }
  button, .btn {
    font: inherit;
    padding: 0.35rem 0.7rem;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--fg);
    cursor: pointer;
  }
  button:hover, .btn:hover { border-color: var(--accent); }
  button.danger { color: var(--danger); }
  .flash { padding: 0.6rem 0.9rem; border-radius: 8px; background: var(--card); border: 1px solid var(--border); margin-bottom: 1.25rem; font-size: 0.9rem; }
  .card { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 1rem 1.25rem; margin-bottom: 1rem; }
  .card dl { display: grid; grid-template-columns: 10rem 1fr; gap: 0.4rem 1rem; margin: 0; }
  .card dt { color: var(--muted); }
  .card dd { margin: 0; }
  .empty { color: var(--muted); padding: 2rem 0; text-align: center; }
</style>
</head>
<body>
<header>
  <a class="brand" href="/">cronify</a>
  <span class="muted mono">scheduler dashboard</span>
</header>
{{if .Flash}}<div class="flash">{{.Flash}}</div>{{end}}
<main>
{{template "content" .}}
</main>
</body>
</html>
{{end}}
